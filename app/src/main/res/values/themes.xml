<resources>
    <style name="Theme.Suwa" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Suwa.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1B1B1F</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Suwa</item>
    </style>
    <style name="Theme.Suwa.Reader" parent="Theme.Suwa">
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p" xmlns:tools="http://schemas.android.com/tools">shortEdges</item>
    </style>
</resources>
